#!ipxe
###
### netboot.xyz-custom menu 
###

:custom
menu Activ@ Recovery
item --gap This is the first sub menu
item option_one ${space} LiveCD (Linux)
item option_two ${space} BootCD (WinPE)
choose custom_choice || goto custom_exit
echo ${cls}
goto ${custom_choice}
goto custom_exit

:option_one
kernel https://boot.netboot.xyz/memdisk raw iso
initrd http://192.168.8.1/usb/isos/activeat_LiveCD.iso
boot || goto custom_exit

:option_two
kernel https://boot.netboot.xyz/memdisk raw iso
initrd http://192.168.8.1/usb/isos/activeat_BootCD.iso
boot || goto custom_exit


:custom_exit
chain utils.ipxe
exit
