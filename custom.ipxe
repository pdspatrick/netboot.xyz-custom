#!ipxe
###
### netboot.xyz-custom menu 
###

:custom
menu Activ@ Recovery
item --gap This is the first sub menu
item option_one ${space} LiveCD (Linux - broken)
item option_two ${space} BootCD (WinPE)
choose custom_choice || goto custom_exit
echo ${cls}
goto ${custom_choice}
goto custom_exit

:option_one
boot http://192.168.8.1/usb/utils/memdisk_uefi.elf http://192.168.8.1/usb/isos/activeat_LiveCD.iso
|| goto custom_exit

:option_two
boot http://192.168.8.1/usb/utils/memdisk_uefi.elf http://192.168.8.1/usb/isos/activeat_BootCD.iso iso
|| goto custom_exit


:custom_exit
exit
